generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  googleId  String   @unique @map("google_id") @db.VarChar(255)
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  avatarUrl String?  @map("avatar_url") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  devices Device[]

  @@map("users")
}

model Device {
  id         String       @id @db.VarChar(50)
  userId     String       @map("user_id") @db.Uuid
  label      String       @db.VarChar(100)
  plantId    String       @map("plant_id") @db.Uuid
  polybagId  String       @map("polybag_id") @db.Uuid
  status     DeviceStatus @default(ACTIVE)
  lastSeenAt DateTime?    @map("last_seen_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  plant   Plant   @relation(fields: [plantId], references: [id], onDelete: Restrict)
  polybag Polybag @relation(fields: [polybagId], references: [id], onDelete: Restrict)

  recommendations RecommendationLog[]

  @@map("devices")
}

model RecommendationLog {
  id       String @id @default(uuid()) @db.Uuid
  deviceId String @map("device_id") @db.VarChar(50)

  phValue       Float @map("ph_value")
  moistureValue Float @map("moisture_value")

  fuzzyIndex   Float  @map("fuzzy_index")
  categoryCode String @map("category_code") @db.VarChar(5)
  actionText   String @map("action_text") @db.Text

  waterVolumeLiter Float   @default(0) @map("water_volume_liter")
  limeDosageGram   Float   @default(0) @map("lime_dosage_gram")
  sulfurDosageGram Float   @default(0) @map("sulfur_dosage_gram")
  reduceWatering   Boolean @default(false) @map("reduce_watering")

  createdAt DateTime @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("recommendation_logs")
}

// =============================================================================
// TABEL 4: raw_sensor_logs
// Menyimpan log data sensor mentah dari ESP32 secara berkala.
//
// ⚠️ CATATAN PENTING (PostgreSQL Native Table Partitioning):
// Tabel ini TIDAK dikelola melalui perintah migrasi Prisma (prisma migrate dev).
// Tabel ini dibuat SECARA MANUAL menggunakan kueri SQL di Supabase SQL Editor
// dengan deklarasi PARTITION BY RANGE (timestamp) untuk dioptimalkan sebagai
// tabel deret waktu (time-series).
//
// Jalankan kueri SQL berikut di Supabase SQL Editor SEBELUM prisma db pull:
//
//   CREATE TABLE "raw_sensor_logs" (
//     "id"         SERIAL,
//     "timestamp"  TIMESTAMPTZ NOT NULL DEFAULT now(),
//     "device_id"  VARCHAR(50) NOT NULL,
//     "ph"         DOUBLE PRECISION NOT NULL,
//     "moisture"   DOUBLE PRECISION NOT NULL,
//     PRIMARY KEY  ("timestamp", "id")
//   ) PARTITION BY RANGE ("timestamp");
//
//   -- Buat partisi untuk bulan aktif saat ini (sesuaikan rentang tanggalnya):
//   CREATE TABLE "raw_sensor_logs_y2026m05"
//     PARTITION OF "raw_sensor_logs"
//     FOR VALUES FROM ('2026-05-01 00:00:00+00') TO ('2026-06-01 00:00:00+00');
//
//   CREATE TABLE "raw_sensor_logs_y2026m06"
//     PARTITION OF "raw_sensor_logs"
//     FOR VALUES FROM ('2026-06-01 00:00:00+00') TO ('2026-07-01 00:00:00+00');
//
// Setelah tabel terbentuk, jalankan: npx prisma db pull
// Prisma akan mendeteksi tabel ini secara otomatis dan model di bawah
// akan diperbarui oleh Prisma.
// =============================================================================
model RawSensorLog {
  id        Int      @default(autoincrement())
  timestamp DateTime @default(now()) @db.Timestamptz(6)
  deviceId  String   @map("device_id") @db.VarChar(50)
  ph        Float    @db.DoublePrecision
  moisture  Float    @db.DoublePrecision

  @@id([timestamp, id])
  @@map("raw_sensor_logs")
}

model Plant {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(100)
  scientificName String?  @map("scientific_name") @db.VarChar(150)
  description    String?  @db.Text
  minPh          Float    @map("min_ph")
  maxPh          Float    @map("max_ph")
  minMoisture    Float    @map("min_moisture")
  maxMoisture    Float    @map("max_moisture")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  devices Device[]

  @@map("plants")
}

model Polybag {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  diameter    Float
  height      Float
  volumeLiter Float    @map("volume_liter")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  devices Device[]

  @@map("polybags")
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  OFFLINE

  @@map("device_status")
}
